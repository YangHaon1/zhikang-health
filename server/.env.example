# 复制为 server/.env 后按需修改（server/.env 不入库）
PORT=3000
# 生产/鉴权用随机密钥，请替换为足够长的随机字符串（B2 鉴权阶段使用）
JWT_SECRET=please-change-me-to-a-long-random-string
# 方案 B（真实大模型）API Key，留空则仅走方案 A 规则引擎
LLM_API_KEY=
# 可选：方案 B 的模型名与网关地址（留空走默认：火山方舟豆包）
# LLM_MODEL=doubao-1-5-pro-32k-250115
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 部署时可显式声明运行环境（本地 pnpm start 不设也能自动托管 dist/）
# NODE_ENV=production
